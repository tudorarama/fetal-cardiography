<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:15px'&gt;1. FOCUS dataset&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;300 four-chamber ultrasound images (200 train / 50 val / 50 test) + heart &amp;amp; thorax ellipse labels&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="640" height="240" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c2"><mxGeometry x="18" y="62" width="190" height="132" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c2"><mxGeometry x="225" y="62" width="190" height="131" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c2"><mxGeometry x="432" y="62" width="190" height="131" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:15px'&gt;2. Data loading &amp;amp; ground truth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;train / val / test split, ellipses → masks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="400" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:15px'&gt;3. Preprocessing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;median filter (speckle) → bilateral filter (edges kept) → CLAHE (local contrast)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="640" height="240" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c7"><mxGeometry x="18" y="62" width="190" height="132" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c7"><mxGeometry x="225" y="62" width="190" height="131" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c7"><mxGeometry x="432" y="62" width="190" height="131" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:15px'&gt;4a. Classical segmentation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;thorax: radial search of the wall + Otsu, robust ellipse fit&lt;br&gt;heart: hierarchical Chan-Vese inside the thorax&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="520" height="330" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c11"><mxGeometry x="150" y="68" width="220" height="220" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:15px'&gt;4b. Deep learning segmentation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;U-Net (MONAI) trained on FOCUS train, 2 sigmoid outputs (heart, thorax)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="520" height="330" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c13"><mxGeometry x="150" y="68" width="220" height="220" as="geometry"/></mxCell><mxCell id="c15" value="raw output: thorax region (green) and dark heart blob (red)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c11"><mxGeometry x="20" y="294" width="480" height="22" as="geometry"/></mxCell><mxCell id="c16" value="raw output: probability maps thresholded at 0.5" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c13"><mxGeometry x="20" y="294" width="480" height="22" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:15px'&gt;5. Post-processing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;largest component → hole filling → ellipse fitting (heart red, thorax green)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="1070" width="640" height="300" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c17"><mxGeometry x="32" y="62" width="170" height="170" as="geometry"/></mxCell><mxCell id="c19" value="CTR = 0.21" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c17"><mxGeometry x="22" y="234" width="190" height="18" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c17"><mxGeometry x="235" y="62" width="170" height="170" as="geometry"/></mxCell><mxCell id="c21" value="CTR = 0.27" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c17"><mxGeometry x="225" y="234" width="190" height="18" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c17"><mxGeometry x="438" y="62" width="170" height="170" as="geometry"/></mxCell><mxCell id="c23" value="CTR = 0.22" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c17"><mxGeometry x="428" y="234" width="190" height="18" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:15px'&gt;6. Segmentation evaluation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Dice and HD95 against the ground-truth masks&lt;br&gt;(test set used once, after tuning on val)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1420" width="520" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:15px'&gt;7. Measurements&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;cardiothoracic ratio CTR = area(heart) / area(thorax)&lt;br&gt;cardiac axis ≈ angle between the major axes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="1420" width="520" height="330" as="geometry"/></mxCell><mxCell id="c26" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c25"><mxGeometry x="150" y="68" width="220" height="220" as="geometry"/></mxCell><mxCell id="c27" value="example: CTR = 0.27 (normal range ≈ 0.25–0.35)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c25"><mxGeometry x="20" y="296" width="480" height="22" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:15px'&gt;8. Anomaly detection (rules, screening only)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;CTR &amp;gt; 0.35 → cardiomegaly &amp;nbsp;|&amp;nbsp; LV/RV or LA/RA outside 0.5–2 → disproportion&lt;br&gt;chamber &amp;lt; 3 % of the heart → missing chamber &amp;nbsp;|&amp;nbsp; axis outside 25–65° → abnormal axis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="1800" width="520" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:15px'&gt;9. Results &amp;amp; comparison&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;heart/thorax: classical vs U-Net vs fixed-circle baseline (Wilcoxon) · chambers: Dice per chamber&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1960" width="640" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style='font-size:15px'&gt;4c. Chamber annotation (own)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;LV, RV, LA, RA drawn on FOCUS images; SAM proposes the outline from a click,&lt;br&gt;the annotator corrects it · optional landmark: spine / descending aorta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="480" height="330" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c30"><mxGeometry x="130" y="80" width="220" height="220" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b style='font-size:15px'&gt;4d. Region of interest&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;square around the FOCUS heart outline (+20 %), resized to 384 × 384&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="780" width="480" height="260" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c32"><mxGeometry x="140" y="52" width="200" height="200" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style='font-size:15px'&gt;4e. nnU-Net v2 (2D, self-configuring)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;trained from scratch on our annotations (fold 0 = FOCUS train / val)&lt;br&gt;fp32 on a GTX 1660; probabilities resized back into the full image&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="1070" width="480" height="300" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c34"><mxGeometry x="140" y="80" width="200" height="200" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:15px'&gt;7b. Chamber measurements&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;LV/RV and LA/RA area ratios · cardiac axis = septum (white) vs&lt;br&gt;spine/aorta → thorax centre line (cyan)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="1420" width="480" height="340" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;strokeColor=#999999;imageBorder=#999999;image=data:image/jpeg,;" vertex="1" parent="c36"><mxGeometry x="130" y="80" width="220" height="220" as="geometry"/></mxCell><mxCell id="c38" value="example: LV/RV = 1.03, LA/RA = 0.91, axis = 41°" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="c36"><mxGeometry x="20" y="306" width="440" height="22" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:15px'&gt;6b. Chamber evaluation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Dice and HD95 per chamber against the hand annotation of the test images&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="1960" width="480" height="80" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="predicted mask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="1970"/></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="images" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c30"><mxGeometry rela